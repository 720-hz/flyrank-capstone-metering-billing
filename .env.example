# Stripe test mode — free, no credit card: https://dashboard.stripe.com/test/apikeys
# Never use a live (sk_live_/pk_live_) key here. Test keys start with sk_test_/pk_test_.
STRIPE_SECRET_KEY=sk_test_your-test-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
# Only needed if you build the optional hosted Checkout success/cancel redirect pages.
APP_BASE_URL=http://localhost:8000

DB_PATH=./billing.db

PORT=8000

# Pro plan's Stripe Price ID (test mode), created once in the Stripe dashboard
# or via `stripe prices create` — see README "Stripe setup".
STRIPE_PRICE_ID_PRO=price_your-test-price-id-here
